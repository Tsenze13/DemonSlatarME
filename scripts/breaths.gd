# Когда стиль открыт в сюжете: tier 0 — сразу (вода) / после Отбора; 1 — с 4-й главы;
# 2 — Солнце после Кагэцу; 3 — Луна после Сэйрэн. Свободная охота — всё.
static func unlocked(id: String, prog: Dictionary, free: bool) -> bool:
	if free:
		return true
	var t: int = STYLES[id].tier
	match t:
		0:
			return id == "water" or int(prog.get("chapter", 0)) >= 2
		1:
			return int(prog.get("chapter", 0)) >= 4
		2:
			return bool(prog.get("finished", false))
		_:
			return bool(prog.get("finished2", false))
